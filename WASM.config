# WebAssembly build with Emscripten:  make WASM=1 DEPS=<dir> [QC_C=<file>]
# DEPS holds boost/ (headers), boost-regex-posix.a and librepp.a + librepp.h,
# built for wasm32 (see wasm/build-deps.sh).
# QC_C is the grammar's quickcheck extractor C (from ACE_QC_C_ONLY=1 ace -G ...).
CC=emcc
LD=emcc
# link with em++ so libc++ (with exception support) is pulled in for Boost.Regex
LINKCC=em++
CFLAGS=-O3 -funsigned-char -w -include $(dir $(lastword $(MAKEFILE_LIST)))wasm-protos.h \
	-Wno-error=implicit-function-declaration -Wno-error=implicit-int \
	-Wno-error=int-conversion -Wno-error=incompatible-pointer-types \
	-Wno-error=return-type -isystem $(DEPS)/include
POST_LIBS=
REPP_LIBS=$(DEPS)/lib/librepp.a
BOOST_REGEX_LIBS=$(DEPS)/lib/boost-regex-posix.a
DELPHIN_CFLAGS=
DELPHIN_LIBS=
EXPORT_DYNAMIC_CFLAG=
LDFLAGS=-sALLOW_MEMORY_GROWTH=1 -sMAXIMUM_MEMORY=4GB -sSTACK_SIZE=8MB \
	-sNODERAWFS=1 -sEXIT_RUNTIME=1 -sENVIRONMENT=node -fexceptions \
	-Wl,--warn-unresolved-symbols $(if $(QC_C),$(QC_C:.c=.o))
# NODERAWFS/ENVIRONMENT=node are for running under Node; a browser build needs
# its own filesystem setup (e.g. -sFORCE_FILESYSTEM and preloading the image).
