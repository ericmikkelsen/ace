# macOS build settings, included automatically by the Makefile on Darwin.
# Apple's clang replaces GCC here. Dependencies come from Homebrew:
#   brew install boost
# librepp is expected under REPP_PREFIX (build and `make install` it there).
BREW_PREFIX?=$(shell brew --prefix 2>/dev/null || echo /usr/local)
REPP_PREFIX?=$(BREW_PREFIX)

CC=clang
# Same intent as the GCC flags above; -falign-loops and -O6 are GCC-only.
# The -Wno-error flags let modern clang accept this older C (implicit int and
# implicit declarations) without changing the code it generates.
# Optional tuning, e.g.:
#   make TUNE=-mcpu=native LTO=-flto
#   make PGO=-fprofile-instr-generate            (then run sample parses)
#   make PGO=-fprofile-instr-use=ace.profdata
TUNE?=
LTO?=
PGO?=
CFLAGS=-g -O3 -fno-omit-frame-pointer -funsigned-char -funroll-loops $(TUNE) $(LTO) $(PGO) \
	-Wno-error=implicit-function-declaration -Wno-error=implicit-int \
	-Wno-error=int-conversion -Wno-error=incompatible-pointer-types \
	-Wno-error=return-type -w \
	-DMACOSX_GCC -isystem $(BREW_PREFIX)/include -I$(REPP_PREFIX)/include
POST_LIBS=
REPP_LIBS=$(REPP_PREFIX)/lib/librepp.a
BOOST_REGEX_LIBS=$(BREW_PREFIX)/lib/libboost_regex.a -lc++
DELPHIN_CFLAGS=
DELPHIN_LIBS=
# the quickcheck extractor (compiled per grammar, loaded with dlopen) calls
# engine functions by name; keep them exported even under LTO
EXPORT_DYNAMIC_CFLAG=-Wl,-export_dynamic
LDFLAGS=
